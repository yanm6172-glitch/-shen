/* 背书刷题神器 - 全局样式 */
page {

  background: #F5F6FA;
  color: #23262F;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

view, text, input, textarea, button { box-sizing: border-box; }

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(35, 38, 47, 0.05);
}

/* 按钮 */
.btn {
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 2.6;
  text-align: center;
  padding: 0 40rpx;
  border: none;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #6C5CE7, #8E7CFF);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(108, 92, 231, 0.35);
}
.btn-primary.btn-disabled { opacity: 0.5; box-shadow: none; }
.btn-plain {
  background: #fff;
  color: #6C5CE7;
  border: 2rpx solid #6C5CE7;
}
.btn-ghost { background: #F1EEFF; color: #6C5CE7; }
.btn-danger { background: #FDECEC; color: #EF4444; }
.btn-block { display: block; width: 100%; }

/* 类型徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.7;
}
.badge-single { background: #EAF1FE; color: #4A7CF7; }
.badge-multi { background: #FEF3E2; color: #F59E0B; }
.badge-judge { background: #E7F8F1; color: #10B981; }
.badge-fill { background: #F1EEFF; color: #6C5CE7; }
.badge-short { background: #E4F8F5; color: #14B8A6; }

/* 通用工具类 */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.flex1 { flex: 1; }
.space-between { justify-content: space-between; }
.center { align-items: center; justify-content: center; }
.text-2 { color: #6B7080; }
.text-3 { color: #9AA0B5; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mb16 { margin-bottom: 16rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 28rpx 16rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9AA0B5;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }

/* 进度条 */
.progress-bar {
  height: 10rpx;
  background: #E8EAF1;
  border-radius: 10rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #8E7CFF);
  border-radius: 10rpx;
  transition: width 0.25s;
}

/* 分割线 */
.divider { height: 2rpx; background: #ECEEF4; margin: 24rpx 0; }
