.page { padding-bottom: 160rpx; }
.head-card .bank-name { font-size: 36rpx; font-weight: 800; }
.head-card .badge { margin-right: 8rpx; margin-top: 8rpx; }

.search-box { display: flex; align-items: center; padding: 20rpx 30rpx; margin-top: 16rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.search-ph { color: #B4B9C9; }
.search-clear { color: #9AA0B5; padding: 0 12rpx; font-size: 30rpx; }

.filter-row { display: flex; gap: 20rpx; margin: 8rpx 24rpx 0; }
.filter-tab {
  flex: 1;
  text-align: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6B7080;
  box-shadow: 0 4rpx 14rpx rgba(35, 38, 47, 0.05);
}
.filter-tab.on { background: linear-gradient(135deg, #6C5CE7, #8E7CFF); color: #fff; font-weight: 700; }

/* 题目状态点 */
.q-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin: 10rpx 10rpx 0 0;
  flex-shrink: 0;
}
.dot-ok { background: #10B981; }
.dot-wrong { background: #EF4444; }
.dot-new { background: #D8DBE6; }
.legend-row {
  display: flex;
  gap: 28rpx;
  margin: 16rpx 32rpx 0;
  font-size: 22rpx;
  color: #6B7080;
}
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-item .q-dot { margin: 0; }

.q-card { margin-top: 16rpx; }
.q-stem { font-size: 28rpx; line-height: 1.6; margin-left: 12rpx; }
.q-card .badge { flex-shrink: 0; margin-top: 4rpx; }
.fav-star { font-size: 40rpx; color: #C4C9D6; margin-right: 12rpx; line-height: 1; flex-shrink: 0; }
.fav-star.on { color: #FFB347; }

.opt-line { font-size: 26rpx; color: #6B7080; margin: 8rpx 0; }
.ans-line { font-size: 26rpx; color: #10B981; margin: 8rpx 0; }
.ans-line.analysis { color: #6C5CE7; }

.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(35, 38, 47, 0.06);
  display: flex;
  gap: 20rpx;
}
.half { flex: 1; }
