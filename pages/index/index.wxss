.page { padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(135deg, #6C5CE7 0%, #8E7CFF 55%, #A99BFF 100%);
  padding: 48rpx 36rpx 100rpx;
  color: #fff;
}
.hero-top { display: flex; align-items: flex-start; }
.hero-title { font-size: 46rpx; font-weight: 800; letter-spacing: 4rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.9; margin-top: 10rpx; }
.flame { font-size: 56rpx; margin-left: 20rpx; }

.goal-card {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.goal-label { font-size: 24rpx; opacity: 0.9; }
.goal-num { font-size: 28rpx; font-weight: 800; }
.goal-bar {
  margin-top: 14rpx;
  height: 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
}
.goal-fill {
  height: 100%;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #FFD66B, #FFB347);
  transition: width 0.4s;
}
.goal-sub { margin-top: 12rpx; font-size: 22rpx; opacity: 0.9; }

.quick-start {
  margin: -60rpx 24rpx 8rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.28);
  position: relative;
  z-index: 2;
}
.qs-icon {
  width: 76rpx; height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #6C5CE7, #8E7CFF);
  color: #fff;
  font-size: 38rpx;
  display: flex; align-items: center; justify-content: center;
}
.qs-title { font-size: 32rpx; font-weight: 800; }
.qs-sub { font-size: 22rpx; color: #9AA0B5; margin-top: 4rpx; }
.qs-go { font-size: 40rpx; color: #C4C9D6; }

.resume {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-left: 8rpx solid #6C5CE7;
}
.resume-icon {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #F1EEFF; color: #6C5CE7;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}
.resume-title { font-weight: 700; }
.resume-sub { font-size: 24rpx; margin-top: 4rpx; }

.card-title { font-size: 30rpx; font-weight: 800; }

/* 趋势图 */
.chart {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
  gap: 14rpx;
}
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.chart-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.chart-bar {
  width: 60%;
  min-height: 10rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #A99BFF, #8E7CFF);
  position: relative;
  transition: height 0.4s;
}
.chart-bar.today { background: linear-gradient(180deg, #FFC46B, #FF9F43); }
.chart-val {
  position: absolute;
  top: -34rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #9AA0B5;
}
.chart-label { margin-top: 10rpx; font-size: 22rpx; color: #9AA0B5; }
.chart-label.today { color: #FF9F43; font-weight: 800; }

/* 统计 */
.stat-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 24rpx 8rpx;
}
.stat-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(35, 38, 47, 0.05);
}
.stat-num { font-size: 36rpx; font-weight: 800; }
.stat-num.green { color: #10B981; }
.stat-label { font-size: 22rpx; color: #9AA0B5; margin-top: 4rpx; }

.entry-row {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 24rpx 8rpx;
}
.entry {
  flex: 1;
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(35, 38, 47, 0.12);
}
.entry-quiz { background: linear-gradient(135deg, #4A7CF7, #6FA3FF); }
.entry-memo { background: linear-gradient(135deg, #14B8A6, #3ED3BF); }
.entry-icon { font-size: 52rpx; }
.entry-title { font-size: 38rpx; font-weight: 800; margin-top: 16rpx; }
.entry-desc {
  font-size: 22rpx; opacity: 0.9; margin-top: 8rpx;
  white-space: pre-line; line-height: 1.6;
}

.quick { padding: 10rpx 30rpx; }
.quick-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #ECEEF4;
}
.quick-item:last-child { border-bottom: none; }
.quick-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
}
.quick-title { font-weight: 700; }
.quick-desc { font-size: 22rpx; margin-top: 4rpx; }
