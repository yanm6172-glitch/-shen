<view class="page">
  <view class="topbar">
    <view class="topbar-title">我的题库（{{banks.length}}）</view>
    <button class="btn btn-primary topbar-btn" bindtap="goImport">＋ 导入题库</button>
  </view>

  <block wx:if="{{banks.length}}">
    <view class="card bank-card" wx:for="{{banks}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="row space-between">
        <view class="bank-name">{{item.name}}</view>
        <view class="bank-del" catchtap="deleteBank" data-id="{{item.id}}" data-name="{{item.name}}">删除</view>
      </view>
      <view class="row mt8">
        <text class="badge badge-single">单选{{item.typeStats.single}}</text>
        <text class="badge badge-multi">多选{{item.typeStats.multi}}</text>
        <text class="badge badge-judge">判断{{item.typeStats.judge}}</text>
        <text class="badge badge-fill">填空{{item.typeStats.fill}}</text>
        <text class="badge badge-short">解答{{item.typeStats.short}}</text>
      </view>
      <view class="row space-between mt8">
        <text class="text-3">{{item.dateStr}}</text>
        <text class="bank-go">开始刷题 ›</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-icon">📚</view>
    <view>还没有题库</view>
    <view class="mt16">
      <button class="btn btn-primary" bindtap="goImport">去导入（粘贴文本 / docx / 示例）</button>
    </view>
  </view>
</view>
