.page { padding-bottom: 200rpx; }

.mode-tabs {
  display: flex;
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(35, 38, 47, 0.05);
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #6B7080;
  border-radius: 16rpx;
}
.mode-tab.active {
  background: linear-gradient(135deg, #14B8A6, #3ED3BF);
  color: #fff;
  font-weight: 700;
}

.sec-card { margin-top: 16rpx; }
.sec-title { font-size: 30rpx; font-weight: 800; color: #14B8A6; margin-bottom: 12rpx; }
.sec-line { font-size: 28rpx; line-height: 1.9; }
.qa-list { margin-top: 12rpx; }
.qa-card {
  background: #F7F8FB;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
}
.qa-q { font-size: 27rpx; font-weight: 600; }
.qa-a { font-size: 27rpx; color: #10B981; margin-top: 8rpx; line-height: 1.7; }
.qa-tip { font-size: 22rpx; color: #9AA0B5; margin-top: 8rpx; }
.tip-line { margin: 24rpx 32rpx; font-size: 24rpx; color: #9AA0B5; }

.cloze-head {
  margin: 24rpx 28rpx 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cloze-score { font-weight: 800; color: #10B981; font-size: 30rpx; }
.cloze-card { margin-top: 16rpx; }
.cloze-hint { font-size: 24rpx; color: #9AA0B5; margin-bottom: 8rpx; }
.cloze-sentence { font-size: 32rpx; line-height: 1.9; }
.cloze-blank {
  display: inline-block;
  min-width: 90rpx;
  text-align: center;
  border-bottom: 4rpx solid #6C5CE7;
  color: #6C5CE7;
  margin: 0 6rpx;
  padding: 0 8rpx;
  font-weight: 700;
  font-size: 34rpx;
}
.cloze-blank.cloze-ok { border-color: #10B981; color: #10B981; }
.cloze-blank.cloze-bad { border-color: #EF4444; color: #EF4444; }
.cloze-input-row { display: flex; align-items: center; margin-top: 18rpx; }
.cloze-len-tag {
  flex-shrink: 0;
  background: #F1EEFF;
  color: #6C5CE7;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  margin-right: 16rpx;
}
.cloze-input {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  background: #FFFFFF;
  border: 3rpx solid #D8DBE6;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #23262F;
}
.cloze-ph { color: #B4B9C9; font-size: 28rpx; font-weight: 400; }
.cloze-ans { margin-top: 12rpx; font-size: 28rpx; }
.cloze-ans.ok { color: #10B981; }
.cloze-ans.bad { color: #EF4444; }

/* AI */
.ai-mode-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 24rpx;
}
.ai-chip {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #6B7080;
  font-size: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(35, 38, 47, 0.06);
}
.ai-chip.on { background: #14B8A6; color: #fff; font-weight: 700; }
.ai-reset { margin-left: auto; font-size: 24rpx; color: #9AA0B5; }

.chat-area {
  height: calc(100vh - 480rpx);
  min-height: 600rpx;
  padding: 8rpx 24rpx;
}
.msg-row { display: flex; gap: 14rpx; margin: 20rpx 0; align-items: flex-start; }
.msg-user { flex-direction: row-reverse; }
.msg-avatar {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: #14B8A6;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.msg-user .msg-avatar { background: #6C5CE7; }
.msg-bubble {
  max-width: 76%;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
}
.bubble-ai { background: #fff; box-shadow: 0 4rpx 14rpx rgba(35, 38, 47, 0.05); white-space: pre-wrap; }
.bubble-user { background: #6C5CE7; color: #fff; white-space: pre-wrap; }
.typing { color: #9AA0B5; }

.chat-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(35, 38, 47, 0.06);
}
.chat-input {
  flex: 1;
  background: #F7F8FB;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}
.chat-send { font-size: 26rpx; line-height: 2.3; padding: 0 36rpx; }

.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(35, 38, 47, 0.06);
  display: flex;
  gap: 20rpx;
}
.flex1 { flex: 1; }
